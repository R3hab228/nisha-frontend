{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/return-policy",
      "destination": "/return-policy.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://nisha-api.onrender.com/sitemap.xml"
    },
    {
      "source": "/share/:id",
      "destination": "/api/share"
    }
  ]
}