{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://nisha-api.onrender.com/sitemap.xml"
    },
    {
      "source": "/share/:id",
      "destination": "https://nisha-api.onrender.com/share/:id"
    },
    {
      "source": "/cdn-images/:match*",
      "destination": "https://nmpuefxqtkhvtltdvllz.supabase.co/storage/v1/object/public/items-images/:match*"
    }
  ],
  "headers": [
    {
      "source": "/cdn-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}