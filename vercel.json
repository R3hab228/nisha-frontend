{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://nisha-api.onrender.com/sitemap.xml"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}