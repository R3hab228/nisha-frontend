{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"]
    },
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "js/**/*",
    "app.js",
    "config.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
