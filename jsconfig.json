{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*",
    "js/**/*",
    "tests/**/*",
    "*.js",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
