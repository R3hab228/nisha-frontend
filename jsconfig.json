{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"]
    },
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "js/**/*",
    "tests/**/*",
    "*.js",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
