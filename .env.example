# =============================================================================
# NISHA STORE — Frontend Environment Variables Template
# Copy this file to .env.local for local development. Never commit secrets!
# =============================================================================

# --- Supabase Public Client (Browser-safe anon key only) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Optional fallback aliases (supported by build/runtime helpers) ---
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Sentry Source Maps Upload (CI / Production Build, Optional) ---
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- CI Deploy Notifications (GitHub Actions, Optional) ---
# TG_BOT_TOKEN=
# TG_ADMIN_ID=
